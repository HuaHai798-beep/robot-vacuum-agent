# ============================================================
# 环境变量示例：复制成 .env 后填自己的 key（.env 已被 .gitignore 忽略）
# 注意：Windows 用户变量设置后需要完全重启 IDE / 终端才生效
# ============================================================

# --- 对话模型：按 config/rag.yml 的 chat_provider 选一个填 ---
# chat_provider: deepseek  -> 需要 DEEPSEEK_API_KEY
# chat_provider: dashscope -> 需要 DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- 演示账号（agent/tools/agent_tools.py 读取；不设则回退 config/agent.yml 的 mock_user）---
AGENT_USER_ID=1001
AGENT_USER_CITY=杭州

# 说明：
# 1) 向量化固定走 DashScope text-embedding-v4（DeepSeek 没有 embedding 模型），
#    所以即使 chat_provider=deepseek，也必须配 DASHSCOPE_API_KEY。
# 2) key 不要写进代码、不要提交；.env / .env.* 已加入 .gitignore。
